# Firebase (Authentication → Sign-in method → enable Google)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Roles — comma-separated Google account e-mails. Everyone else has general access.
# These lists ship in the client bundle and gate the UI only; protect server data with rules.
VITE_ADMIN_EMAILS=
VITE_SUPERADMIN_EMAILS=
